index 0000000..d2dd6ee
--- /dev/null
+++ b/packages/common/nbstore/src/impls/blog-local/index.ts
@@ -0,0 +1,155 @@
+import { AutoReconnectConnection, share } from '../../connection';
+import {
+  BlobStorageBase,
+  DocStorageBase,
+  type BlobRecord,
+  type ListedBlobRecord,
+  type DocRecord,
+  type DocUpdate,
+  type DocStorageOptions,
+} from '../../storage';
+import { nativeRequest } from './transport';
+export * from './transport';
+type Options = DocStorageOptions & { flavour: string; type: string };
+const space = (opts: Options) => `${opts.flavour}:${opts.type}:${opts.id}`;
+type RecordRow = { docId: string; bin: number[]; at: number };
+const record = (row: RecordRow): DocRecord => ({
+  docId: row.docId,
+  bin: new Uint8Array(row.bin),
+  timestamp: new Date(row.at),
+});
+class NativeConnection extends AutoReconnectConnection<BroadcastChannel> {
+  constructor(private readonly space: string) {
+    super();
+  }
+  override get shareId() {
+    return `native:${this.space}`;
+  }
+  protected override async doConnect() {
+    return new BroadcastChannel(this.shareId);
+  }
+  protected override doDisconnect(channel: BroadcastChannel) {
+    channel.close();
+  }
+}
+export class NativeDocStorage extends DocStorageBase<Options> {
+  static readonly identifier = 'NativeDocStorage';
+  readonly connection = share(new NativeConnection(space(this.options)));
+  private request<T>(op: string, args: Record<string, unknown> = {}) {
+    return nativeRequest<T>({ op, space: space(this.options), ...args });
+  }
+  override async pushDocUpdate(update: DocUpdate, origin?: string) {
+    const at = await this.request<number>('push', {
+      id: update.docId,
+      bin: Array.from(update.bin),
+    });
+    const result = { ...update, timestamp: new Date(at) };
+    this.emit('update', result, origin);
+    this.connection.inner.postMessage({ update: result, origin });
+    return { docId: update.docId, timestamp: result.timestamp };
+  }
+  override subscribeDocUpdate(
+    callback: (update: DocRecord, origin?: string) => void
+  ) {
+    const channel = this.connection.inner;
+    const listener = (event: MessageEvent) =>
+      callback(event.data.update, event.data.origin);
+    channel.addEventListener('message', listener);
+    const off = super.subscribeDocUpdate(callback);
+    return () => {
+      off();
+      channel.removeEventListener('message', listener);
+    };
+  }
+  protected override async getDocSnapshot(id: string) {
+    const row = await this.request<RecordRow | null>('snapshot', { id });
+    return row ? record(row) : null;
+  }
+  protected override setDocSnapshot(doc: DocRecord) {
+    return this.request<boolean>('setSnapshot', {
+      id: doc.docId,
+      bin: Array.from(doc.bin),
+      at: doc.timestamp.getTime(),
+    });
+  }
+  protected override async getDocUpdates(id: string) {
+    return (await this.request<RecordRow[]>('updates', { id })).map(record);
+  }
+  protected override markUpdatesMerged(id: string, updates: DocRecord[]) {
+    return this.request<number>('merge', {
+      id,
+      times: updates.map(u => u.timestamp.getTime()),
+    });
+  }
+  override async getDocTimestamp(id: string) {
+    const at = await this.request<number | null>('clock', { id });
+    return at === null ? null : { docId: id, timestamp: new Date(at) };
+  }
+  override async getDocTimestamps(after?: Date) {
+    return Object.fromEntries(
+      (
+        await this.request<{ id: string; at: number }[]>('clocks', {
+          after: after?.getTime() ?? 0,
+        })
+      ).map(row => [row.id, new Date(row.at)])
+    );
+  }
+  override async deleteDoc(id: string) {
+    await this.request('deleteDoc', { id });
+  }
+}
+export class NativeBlobStorage extends BlobStorageBase {
+  static readonly identifier = 'NativeBlobStorage';
+  readonly isReadonly = false;
+  readonly connection;
+  constructor(private readonly options: Options) {
+    super();
+    this.connection = share(new NativeConnection(space(options)));
+  }
+  private request<T>(op: string, args: Record<string, unknown> = {}) {
+    return nativeRequest<T>({ op, space: space(this.options), ...args });
+  }
+  override async get(id: string): Promise<BlobRecord | null> {
+    const row = await this.request<{
+      key: string;
+      data: number[];
+      mime: string;
+      at: number;
+    } | null>('blobGet', { id });
+    return row
+      ? {
+          key: row.key,
+          data: new Uint8Array(row.data),
+          mime: row.mime,
+          createdAt: new Date(row.at),
+        }
+      : null;
+  }
+  override async set(blob: BlobRecord) {
+    await this.request('blobSet', {
+      id: blob.key,
+      data: Array.from(blob.data),
+      mime: blob.mime,
+      at: blob.createdAt?.getTime(),
+    });
+  }
+  override async delete(id: string, permanently: boolean) {
+    await this.request('blobDelete', { id, permanently });
+  }
+  override async release() {
+    await this.request('blobRelease');
+  }
+  override async list(): Promise<ListedBlobRecord[]> {
+    return (
+      await this.request<
+        { key: string; mime: string; size: number; at: number }[]
+      >('blobList')
+    ).map(row => ({
+      key: row.key,
+      mime: row.mime,
+      size: row.size,
+      createdAt: new Date(row.at),
+    }));
+  }
+}
+export const nativeStorages = [NativeDocStorage, NativeBlobStorage];
diff --git a/packages/common/nbstore/src/impls/blog-local/transport.test.ts b/packages/common/nbstore/src/impls/blog-local/transport.test.ts
