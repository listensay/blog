diff --git a/packages/frontend/core/src/modules/organize/blog-folders.test.ts b/packages/frontend/core/src/modules/organize/blog-folders.test.ts
new file mode 100644
index 0000000..dcac305
--- /dev/null
+++ b/packages/frontend/core/src/modules/organize/blog-folders.test.ts
@@ -0,0 +1,162 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import type { BlogFolderStorage } from './blog-folders';
+
+const {
+  BLOG_ROOT_FOLDER_ID,
+  PAGE_ROOT_FOLDER_ID,
+  isBlogRootFolder,
+  syncBlogFolders,
+}: typeof import('./blog-folders') = await import(
+  new URL('./blog-folders.ts', import.meta.url).href
+);
+
+type Folder = NonNullable<ReturnType<BlogFolderStorage['folders']['get']>>;
+type Assignment = NonNullable<
+  ReturnType<BlogFolderStorage['blogFolderSync']['get']>
+>;
+function fixture() {
+  const records = new Map<string, Folder>();
+  const assignments = new Map<string, Assignment>();
+  let nextId = 0;
+  const db: BlogFolderStorage = {
+    folders: {
+      get: (id) => records.get(id) ?? null,
+      find: (filter = {}) =>
+        [...records.values()].filter((row) =>
+          Object.entries(filter).every(
+            ([key, value]) => row[key as keyof Folder] === value
+          )
+        ),
+      create: (input) => {
+        const record = { ...input, id: input.id ?? `native-${++nextId}` };
+        records.set(record.id, record);
+        return record;
+      },
+      update: (id, input) =>
+        records.set(id, { ...records.get(id)!, ...input, id }),
+    },
+    blogFolderSync: {
+      get: (id) => assignments.get(id) ?? null,
+      create: (input) => assignments.set(input.docId, input),
+    },
+  };
+  const entries = new Map<string, { kind: 'post' | 'page'; category?: string }>(
+    [
+      ['article', { kind: 'post', category: 'AI' }],
+      ['page', { kind: 'page' }],
+    ]
+  );
+  const sync = () =>
+    syncBlogFolders(db, entries, (before) =>
+      String(Number(before ?? 0) + 1).padStart(6, '0')
+    );
+  return { db, records, assignments, entries, sync };
+}
+
+test('migration preserves existing folders and creates native links only once', () => {
+  const f = fixture();
+  f.db.folders.create({
+    id: 'personal',
+    parentId: null,
+    type: 'folder',
+    data: '我的目录',
+    index: '000001',
+  });
+  f.sync();
+  const snapshot = [...f.records];
+  f.sync();
+  assert.deepEqual([...f.records], snapshot);
+  assert.equal(f.records.get('personal')?.data, '我的目录');
+  assert.equal(
+    f.records.get(f.assignments.get('article')!.linkId)?.parentId,
+    'blog-category-AI'
+  );
+  assert.equal(
+    f.records.get(f.assignments.get('page')!.linkId)?.parentId,
+    PAGE_ROOT_FOLDER_ID
+  );
+});
+
+test('root and category renames, including duplicate names, survive synchronization', () => {
+  const f = fixture();
+  f.sync();
+  for (const id of [
+    BLOG_ROOT_FOLDER_ID,
+    PAGE_ROOT_FOLDER_ID,
+    'blog-category-AI',
+  ])
+    f.db.folders.update(id, { data: '同名目录' });
+  f.sync();
+  for (const id of [
+    BLOG_ROOT_FOLDER_ID,
+    PAGE_ROOT_FOLDER_ID,
+    'blog-category-AI',
+  ])
+    assert.equal(f.records.get(id)?.data, '同名目录');
+  f.entries.set('new-article', { kind: 'post', category: 'AI' });
+  f.sync();
+  assert.equal(
+    f.records.get(f.assignments.get('new-article')!.linkId)?.parentId,
+    'blog-category-AI'
+  );
+  assert.equal(f.records.get('blog-category-AI')?.data, '同名目录');
+});
+
+test('deleted categories and removed links are not recreated on refresh', () => {
+  const f = fixture();
+  f.sync();
+  f.records.delete('blog-category-AI');
+  f.records.delete(f.assignments.get('article')!.linkId);
+  f.records.delete(f.assignments.get('page')!.linkId);
+  f.sync();
+  assert.deepEqual(
+    [...f.records.keys()].sort(),
+    [BLOG_ROOT_FOLDER_ID, PAGE_ROOT_FOLDER_ID].sort()
+  );
+});
+
+test('manual moves survive refresh; explicit publication category changes move the managed link', () => {
+  const f = fixture();
+  f.sync();
+  const linkId = f.assignments.get('article')!.linkId;
+  const folder = f.db.folders.create({
+    parentId: BLOG_ROOT_FOLDER_ID,
+    type: 'folder',
+    data: '开发',
+    index: '000010',
+  });
+  f.db.folders.update(linkId, { parentId: folder.id });
+  f.sync();
+  assert.equal(f.records.get(linkId)?.parentId, folder.id);
+  f.entries.set('article', { kind: 'post', category: ' 开发 ' });
+  f.sync();
+  assert.equal(f.assignments.get('article')?.linkId, linkId);
+  assert.equal(f.records.get(linkId)?.parentId, folder.id);
+  assert.equal(
+    f.db.folders
+      .find()
+      .filter((row) => row.type === 'folder' && row.data === '开发').length,
+    1
+  );
+  f.entries.set('article', { kind: 'post', category: '福利' });
+  f.sync();
+  assert.equal(
+    f.records.get(linkId)?.parentId,
+    'blog-category-%E7%A6%8F%E5%88%A9'
+  );
+  assert.equal(
+    f.db.folders
+      .find()
+      .filter((row) => row.type === 'doc' && row.data === 'article').length,
+    1
+  );
+});
+
+test('only the two stable root identities are protected, independently of their names', () => {
+  assert.equal(isBlogRootFolder(BLOG_ROOT_FOLDER_ID), true);
+  assert.equal(isBlogRootFolder(PAGE_ROOT_FOLDER_ID), true);
+  assert.equal(isBlogRootFolder('blog-category-AI'), false);
+  assert.equal(isBlogRootFolder('博客'), false);
+  assert.equal(isBlogRootFolder(null), false);
+});
diff --git a/packages/frontend/core/src/modules/organize/blog-folders.ts b/packages/frontend/core/src/modules/organize/blog-folders.ts
new file mode 100644
index 0000000..344880d
--- /dev/null
+++ b/packages/frontend/core/src/modules/organize/blog-folders.ts
@@ -0,0 +1,110 @@
+export const BLOG_ROOT_FOLDER_ID = 'blog-system-post';
+export const PAGE_ROOT_FOLDER_ID = 'blog-system-page';
+
+export function isBlogRootFolder(id: string | null | undefined) {
+  return id === BLOG_ROOT_FOLDER_ID || id === PAGE_ROOT_FOLDER_ID;
+}
+
+type FolderRecord = {
+  id: string;
+  parentId?: string | null;
+  type: string;
+  data: string;
+  index: string;
+};
+type FolderInput = Omit<FolderRecord, 'id'> & { id?: string };
+type SyncRecord = { docId: string; signature: string; linkId: string };
+export type BlogFolderStorage = {
+  folders: {
+    get(id: string): FolderRecord | null;
+    find(filter?: { parentId?: string | null }): FolderRecord[];
+    create(input: FolderInput): FolderRecord;
+    update(id: string, input: Partial<FolderInput>): unknown;
+  };
+  blogFolderSync: {
+    get(docId: string): SyncRecord | null;
+    create(input: SyncRecord): unknown;
+  };
+};
+
+// Names and user edits live in the native folder table. The source signature
+// only changes on publication, so refresh never recreates removed links/folders
+// or undoes a rename, move, or manual addition.
+export function syncBlogFolders(
+  db: BlogFolderStorage,
+  entries: ReadonlyMap<string, { kind: 'post' | 'page'; category?: string }>,
+  generateIndex: (before: string | null, after: string | null) => string
+) {
+  const nextIndex = (parentId: string | null) => {
+    const last = db.folders
+      .find({ parentId })
+      .map((node) => node.index)
+      .sort()
+      .at(-1);
+    return generateIndex(last ?? null, null);
+  };
+  for (const [id, name] of [
+    [BLOG_ROOT_FOLDER_ID, '博客'],
+    [PAGE_ROOT_FOLDER_ID, '页面'],
+  ]) {
+    if (!db.folders.get(id)) {
+      db.folders.create({
+        id,
+        parentId: null,
+        type: 'folder',
+        data: name,
+        index: nextIndex(null),
+      });
+    }
+  }
+
+  for (const [docId, metadata] of entries) {
+    const category =
+      metadata.kind === 'post' ? metadata.category?.trim() || '未分类' : '';
+    const signature = JSON.stringify([metadata.kind, category]);
+    const previous = db.blogFolderSync.get(docId);
+    if (previous?.signature === signature) continue;
+
+    let parentId = PAGE_ROOT_FOLDER_ID;
+    if (metadata.kind === 'post') {
+      const categoryId = `blog-category-${encodeURIComponent(category)}`;
+      // Preserve renamed categories by stable identity, and reuse a native
+      // category the user created with this name instead of duplicating it.
+      const folder =
+        db.folders.get(categoryId) ??
+        db.folders
+          .find({ parentId: BLOG_ROOT_FOLDER_ID })
+          .find(
+            (node) => node.type === 'folder' && node.data.trim() === category
+          );
+      parentId =
+        folder?.id ??
+        db.folders.create({
+          id: categoryId,
+          parentId: BLOG_ROOT_FOLDER_ID,
+          type: 'folder',
+          data: category,
+          index: nextIndex(BLOG_ROOT_FOLDER_ID),
+        }).id;
+    }
+
+    const existing = db.folders
+      .find({ parentId })
+      .find((node) => node.type === 'doc' && node.data === docId);
+    const oldLink = previous ? db.folders.get(previous.linkId) : null;
+    let linkId = existing?.id;
+    if (!linkId && oldLink?.type === 'doc' && oldLink.data === docId) {
+      db.folders.update(oldLink.id, { parentId, index: nextIndex(parentId) });
+      linkId = oldLink.id;
+    }
+    if (!linkId) {
+      linkId = db.folders.create({
+        parentId,
+        type: 'doc',
+        data: docId,
+        index: nextIndex(parentId),
+      }).id;
+    }
+    db.blogFolderSync.create({ docId, signature, linkId });
+  }
+}
