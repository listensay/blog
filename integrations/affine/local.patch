@@ -0,0 +1,46 @@
+import { notify } from '@affine/component';
+import {
+  isBlogWorkspaceHost,
+  useBlogContentIndex,
+} from '@affine/core/components/blog-content/catalog';
+import { WorkspaceDBService } from '@affine/core/modules/db';
+import { syncBlogFolders } from '@affine/core/modules/organize/blog-folders';
+import { WorkspaceService } from '@affine/core/modules/workspace';
+import {
+  generateFractionalIndexingKeyBetween,
+  useService,
+} from '@toeverything/infra';
+import { useEffect, useState } from 'react';
+
+function SyncBlogFolders() {
+  const index = useBlogContentIndex();
+  const { db } = useService(WorkspaceDBService);
+  const { workspace } = useService(WorkspaceService);
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    const abort = new AbortController();
+    void Promise.all([
+      workspace.engine.doc.waitForDocLoaded('db$folders', abort.signal),
+      workspace.engine.doc.waitForDocLoaded('db$blogFolderSync', abort.signal),
+    ])
+      .then(() => {
+        if (!abort.signal.aborted) setReady(true);
+      })
+      .catch((error) => {
+        if (!abort.signal.aborted)
+          notify.error({ title: '目录载入失败', message: String(error) });
+      });
+    return () => abort.abort();
+  }, [workspace]);
+
+  useEffect(() => {
+    if (ready) syncBlogFolders(db, index, generateFractionalIndexingKeyBetween);
+  }, [db, index, ready]);
+
+  return null;
+}
+
+// The native folder renderer now owns menus, favorites, children and renaming.
+export const BlogSystemFolders = () =>
+  isBlogWorkspaceHost() ? <SyncBlogFolders /> : null;
