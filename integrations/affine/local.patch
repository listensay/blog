+import 'fake-indexeddb/auto';
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+(globalThis as any).BUILD_CONFIG = {
+  appVersion: '0.27.4',
+  appBuildType: 'stable',
+  debug: false,
+};
+const { localQuery, executeLocal } = await import('./blog-local-local');
+const gql = await import('@affine/graphql');
+async function create(workspaceId: string) {
+  const result = await localQuery({
+    query: gql.createCopilotSessionMutation,
+    variables: { options: { workspaceId, promptName: 'Chat With AFFiNE AI' } },
+  });
+  return result.createCopilotSession;
+}
+async function history(workspaceId: string) {
+  const result = await localQuery({
+    query: gql.getCopilotHistoriesQuery,
