+import { WorkspaceService } from '@affine/core/modules/workspace';
+import { nativeBridge } from '@affine/nbstore/blog-local';
+import { LiveData, useLiveData, useService } from '@toeverything/infra';
+import { useEffect } from 'react';
+
+export type BlogContentKind = 'post' | 'page';
+type BlogContentMetadata = { kind: BlogContentKind; category?: string };
+type ContentIndex = ReadonlyMap<string, BlogContentMetadata>;
+type Catalog = {
+  value$: LiveData<ContentIndex>;
+  loaded: boolean;
+  revision: number;
+  users: number;
+  onFocus?: () => void;
+};
+const catalogs = new Map<string, Catalog>();
+
+function catalogFor(workspaceId: string): Catalog {
+  let catalog = catalogs.get(workspaceId);
+  if (!catalog) {
+    catalog = {
+      value$: new LiveData<ContentIndex>(new Map()),
+      loaded: false,
+      revision: 0,
+      users: 0,
+    };
+    catalogs.set(workspaceId, catalog);
+  }
+  return catalog;
+}
+
+export function isBlogWorkspaceHost() {
+  return typeof window !== 'undefined' && '__BLOG_HOST__' in window;
+}
+
+export async function refreshBlogContentIndex(workspaceId: string) {
+  if (!isBlogWorkspaceHost()) return;
+  const catalog = catalogFor(workspaceId);
+  const revision = ++catalog.revision;
+  const entries = await nativeBridge()!.invoke<
+    (BlogContentMetadata & { docId: string })[]
+  >('blog_documents', { workspaceId });
+  if (revision !== catalog.revision) return;
+  catalog.value$.next(
+    new Map(
+      entries
+        .filter((e) => e.kind === 'post' || e.kind === 'page')
+        .map(({ docId, kind, category }) => [docId, { kind, category }])
+    )
+  );
+  catalog.loaded = true;
+}
+
+export function setBlogContentMetadata(
+  workspaceId: string,
+  docId: string,
+  metadata: BlogContentMetadata
+) {
+  const catalog = catalogFor(workspaceId);
+  ++catalog.revision; // A pending read must not overwrite this successful publication.
+  catalog.value$.next(new Map(catalog.value$.value).set(docId, metadata));
+}
+
+export function useBlogContentIndex() {
+  const workspaceId = useService(WorkspaceService).workspace.id;
+  const catalog = catalogFor(workspaceId);
+  const value = useLiveData(catalog.value$);
+  useEffect(() => {
+    if (!isBlogWorkspaceHost()) return;
+    const refresh = () => {
+      void refreshBlogContentIndex(workspaceId).catch((error) =>
+        console.error('[blog-catalog]', error)
+      );
+    };
+    // Share the request/listener across all visible badges and both folders.
+    if (catalog.users++ === 0) {
+      if (!catalog.loaded) refresh();
+      catalog.onFocus = refresh;
+      window.addEventListener('focus', refresh);
+    }
+    return () => {
+      if (--catalog.users === 0 && catalog.onFocus) {
+        window.removeEventListener('focus', catalog.onFocus);
+        catalog.onFocus = undefined;
+      }
+    };
+  }, [catalog, workspaceId]);
+  return value;
+}
