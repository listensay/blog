index 0000000..af410b2
--- /dev/null
+++ b/packages/frontend/core/src/desktop/pages/workspace/detail-page/use-blog-save-status.ts
@@ -0,0 +1,84 @@
+import type { Workspace } from '@affine/core/modules/workspace';
+import { nativeBridge } from '@affine/nbstore/blog-local';
+import type { Store } from '@blocksuite/affine/store';
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+type PublicationStatus = {
+  savedRevision: number | null;
+  published: boolean;
+  draft: boolean;
+};
+type SaveStatus = 'checking' | 'saving' | 'unpublished' | 'published' | 'error';
+
+export function useBlogSaveStatus(page: Store, workspace: Workspace) {
+  const [status, setStatus] = useState<SaveStatus>('checking');
+  const [refreshKey, setRefreshKey] = useState(0);
+  const revision = useRef(0);
+  const refresh = useCallback(() => setRefreshKey((key) => key + 1), []);
+
+  const readSavedVersion = useCallback(async () => {
+    const version = revision.current;
+    await workspace.engine.doc.waitForDocLoaded(
+      page.id,
+      AbortSignal.timeout(20000)
+    );
+    await (
+      window as unknown as { __BLOG_LOCAL_NOTES_FLUSH__: () => Promise<void> }
+    ).__BLOG_LOCAL_NOTES_FLUSH__();
+    const result = await nativeBridge()!.invoke<PublicationStatus>(
+      'blog_publication_status',
+      { workspaceId: workspace.id, docId: page.id }
+    );
+    return { ...result, isCurrent: () => version === revision.current };
+  }, [page, workspace]);
+
+  useEffect(() => {
+    let disposed = false;
+    let request = 0;
+    let timer: ReturnType<typeof setTimeout>;
+    const check = async () => {
+      const currentRequest = ++request;
+      try {
+        const saved = await readSavedVersion();
+        if (disposed || currentRequest !== request || !saved.isCurrent())
+          return;
+        setStatus(
+          saved.savedRevision === null
+            ? 'error'
+            : saved.published
+              ? 'published'
+              : 'unpublished'
+        );
+      } catch {
+        if (!disposed && currentRequest === request) setStatus('error');
+      }
+    };
+    const changed = () => {
+      revision.current++;
+      request++;
+      setStatus('saving');
+      clearTimeout(timer);
+      timer = setTimeout(() => void check(), 700);
+    };
+    const failed = () => {
+      request++;
+      clearTimeout(timer);
+      setStatus('error');
+    };
+    const focused = () => void check();
+    page.spaceDoc.on('update', changed);
+    window.addEventListener('focus', focused);
+    window.addEventListener('blog-local-storage-error', failed);
+    void check();
+    return () => {
+      disposed = true;
+      revision.current++;
+      clearTimeout(timer);
+      page.spaceDoc.off('update', changed);
+      window.removeEventListener('focus', focused);
+      window.removeEventListener('blog-local-storage-error', failed);
+    };
+  }, [page, readSavedVersion, refreshKey]);
+
+  return { status, refresh, readSavedVersion };
+}
