@@ -0,0 +1,54 @@
+import { getStoreManager } from '@affine/core/blocksuite/manager/store';
+import { refreshBlogContentIndex } from '@affine/core/components/blog-content/catalog';
+import { notify } from '@affine/component';
+import { router } from '@affine/core/desktop/router';
+import { WorkspacesService, getAFFiNEWorkspaceSchema } from '@affine/core/modules/workspace';
+import { MarkdownTransformer } from '@blocksuite/affine/widgets/linked-doc';
+import { nativeBridge, flushNativeRequests } from '@affine/nbstore/blog-local';
+import type { FrameworkProvider } from '@toeverything/infra';
+
+export function installBlogBridge(framework: FrameworkProvider) {
+  const service = framework.get(WorkspacesService);
+  const invoke = nativeBridge()!.invoke;
+  void (async () => {
+    const list = await service.list.workspaces$.waitFor(list => list.some(m => m.flavour === 'local'));
+    const meta = list.find(m => m.flavour === 'local')!;
+    const { workspace, dispose } = service.open({ metadata: meta });
+    try {
+      await workspace.engine.doc.waitForDocReady(workspace.id);
+      const input = await invoke<{ file: string; title: string; markdown: string }[]>('blog_seed', { workspaceId: meta.id });
+      console.info('[blog-import] entries', input.length);
+      for (const entry of input) {
+        console.info('[blog-import] starting', entry.file);
+        const docId = await MarkdownTransformer.importMarkdownToDoc({
+          collection: workspace.docCollection,
+          schema: getAFFiNEWorkspaceSchema(),
+          markdown: entry.markdown.replace(/([(<"'])\/(images|affine-assets)\//g, `$1${location.origin}/blog-public/$2/`),
+          fileName: entry.title,
+          extensions: getStoreManager().config.init().value.get('store'),
+        });
+        console.info('[blog-import] created', docId);
+        if (!docId) throw new Error(`${entry.title} 导入失败`);
+        await workspace.engine.doc.waitForDocLoaded(docId);
+        await workspace.engine.doc.waitForUpdated(docId);
+        console.info('[blog-import] updated', docId);
+        await flushNativeRequests();
+        console.info('[blog-import] flushed', docId);
+        await invoke('blog_bind', { workspaceId: meta.id, docId, file: entry.file });
+      }
+      await invoke('blog_seed_done', { workspaceId: meta.id });
+      await refreshBlogContentIndex(meta.id);
+      // The router has already redirected the entry URL by the time import ends.
+      const file = (globalThis as unknown as { __BLOG_HOST__?: { requestedFile?: string } }).__BLOG_HOST__?.requestedFile;
+      if (file) {
+        const binding = await invoke<{ docId: string; workspaceId: string } | null>('blog_find', { file });
+        if (binding) await router.navigate(`/workspace/${binding.workspaceId}/${binding.docId}`);
+      }
+      window.parent.postMessage({ type: 'blog-workspace-ready' }, location.origin);
+    } finally { dispose(); }
+  })().catch(error => {
+    console.error('[blog-import]', error);
+    notify.error({ title: '博客内容未能载入', message: String(error.message || error) });
+    window.parent.postMessage({ type: 'blog-workspace-error', error: String(error.message || error) }, location.origin);
+  });
+}
