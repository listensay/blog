diff --git a/packages/frontend/core/src/desktop/pages/workspace/detail-page/blog-publish.tsx b/packages/frontend/core/src/desktop/pages/workspace/detail-page/blog-publish.tsx
new file mode 100644
index 0000000..2db5871
--- /dev/null
+++ b/packages/frontend/core/src/desktop/pages/workspace/detail-page/blog-publish.tsx
@@ -0,0 +1,387 @@
+import { useState } from 'react';
+import { createPortal } from 'react-dom';
+import { notify } from '@affine/component';
+import { Button } from '@affine/component/ui/button';
+import { createTransformer } from '@affine/core/components/hooks/affine/use-export-page';
+import {
+  setBlogContentMetadata,
+  type BlogContentKind,
+} from '@affine/core/components/blog-content/catalog';
+import type { Workspace } from '@affine/core/modules/workspace';
+import { nativeBridge } from '@affine/nbstore/blog-local';
+import { MarkdownAdapterFactoryIdentifier } from '@blocksuite/affine/shared/adapters';
+import { getAssetName, type Store } from '@blocksuite/affine/store';
+import { useBlogSaveStatus } from './use-blog-save-status';
+import * as styles from './blog-publish.css';
+
+type Metadata = {
+  kind: string;
+  locale: string;
+  slug: string;
+  directory: string;
+  date: string;
+  description: string;
+  category: string;
+  tags: string[];
+  cover: string;
+  comments: boolean;
+  draft: boolean;
+};
+const invoke = <T,>(command: string, args: Record<string, unknown>) =>
+  nativeBridge()!.invoke<T>(command, args);
+export function BlogPublishButton({
+  page,
+  workspace,
+  compact = false,
+}: {
+  page: Store;
+  workspace: Workspace;
+  compact?: boolean;
+}) {
+  const [meta, setMeta] = useState<Metadata | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const { status, refresh, readSavedVersion } = useBlogSaveStatus(
+    page,
+    workspace
+  );
+  const open = async () => {
+    try {
+      setError('');
+      setMeta(
+        await invoke<Metadata>('blog_metadata', {
+          workspaceId: workspace.id,
+          docId: page.id,
+        })
+      );
+    } catch (error: any) {
+      notify.error({ title: '发布设置未能打开', message: error.message });
+    }
+  };
+  const publish = async () => {
+    if (!meta || busy) return;
+    setBusy(true);
+    setError('');
+    try {
+      const std = document.querySelector('editor-host')?.std;
+      if (!std) throw new Error('请等待编辑器载入');
+      const version = await readSavedVersion();
+      if (!version.isCurrent() || version.savedRevision === null)
+        throw new Error('请等待文档保存完成后再发布');
+      const transformer = createTransformer(page);
+      const adapter = std.store.provider
+        .get(MarkdownAdapterFactoryIdentifier)
+        .get(transformer);
+      const result = await adapter.fromDoc(page);
+      if (!result) throw new Error('文档导出失败');
+      const assets = [];
+      for (const id of result.assetsIds) {
+        const blob = transformer.assets?.get(id);
+        if (!blob || !transformer.assets)
+          throw new Error('有附件未能读取，请稍后重试');
+        if (blob.size > 24 * 1024 * 1024)
+          throw new Error('附件超过 24 MB，请缩小后再发布');
+        let binary = '';
+        const bytes = new Uint8Array(await blob.arrayBuffer());
+        for (let offset = 0; offset < bytes.length; offset += 32768)
+          binary += String.fromCharCode(
+            ...bytes.subarray(offset, offset + 32768)
+          );
+        assets.push({
+          name: `assets/${getAssetName(transformer.assets, id)}`,
+          mime: blob.type,
+          data: btoa(binary),
+        });
+      }
+      if (!version.isCurrent())
+        throw new Error('文档已有新修改，请等待保存后重新发布');
+      const saved = await invoke<{ path: string }>('blog_publish', {
+        workspaceId: workspace.id,
+        docId: page.id,
+        documentRevision: version.savedRevision,
+        title: page.meta?.title || '',
+        markdown: result.file,
+        metadata: meta,
+        assets,
+      });
+      setBlogContentMetadata(workspace.id, page.id, {
+        kind: meta.kind as BlogContentKind,
+        category: meta.category,
+      });
+      refresh();
+      notify.success({
+        title: meta.draft ? '草稿已保存，尚未发布' : '已发布到本地博客',
+        message: saved.path,
+      });
+      setMeta(null);
+    } catch (error: any) {
+      setError(error.message || String(error));
+    } finally {
+      setBusy(false);
+    }
+  };
+  const field = (key: keyof Metadata, label: string, placeholder = '') => (
+    <label style={{ display: 'grid', gap: 6 }}>
+      {label}
+      <input
+        aria-label={label}
+        style={inputStyle}
+        value={String(meta?.[key] ?? '')}
+        placeholder={placeholder}
+        onChange={(e) => setMeta((m) => m && { ...m, [key]: e.target.value })}
+      />
+    </label>
+  );
+  return (
+    <>
+      <div className={styles.actions} data-compact={compact}>
+        <span
+          role="status"
+          aria-live="polite"
+          aria-atomic="true"
+          data-testid="blog-save-status"
+          data-state={status}
+          className={styles.status}
+          title={
+            status === 'published'
+              ? '当前内容已发布到本地博客，线上站点仍需重新部署。'
+              : status === 'error'
+                ? '未能确认保存完成，请重试。'
+                : '自动保存仅保存文档。需要点击「发布到博客」才会更新博客内容。'
+          }
+        >
+          <span className={styles.dot} aria-hidden="true" />
+          {status === 'checking'
+            ? '检查保存状态…'
+            : status === 'saving'
+              ? '正在保存…'
+              : status === 'published'
+                ? compact
+                  ? '本地已发布'
+                  : '已发布到本地博客'
+                : status === 'error'
+                  ? '保存未完成'
+                  : compact
+                    ? '已保存 · 未发布'
+                    : '已保存，尚未发布'}
+          {status === 'error' && (
+            <button
+              type="button"
+              onClick={refresh}
+              className={styles.retryButton}
+            >
+              重试
+            </button>
+          )}
+        </span>
+        <Button
+          onClick={open}
+          variant="secondary"
+          className={styles.publishButton}
+          aria-label="发布到博客"
+        >
+          {compact ? '发布' : '发布到博客'}
+        </Button>
+      </div>
+      {meta &&
+        createPortal(
+          <div
+            role="dialog"
+            aria-modal="true"
+            aria-label="发布到博客"
+            onKeyDown={(e) => {
+              e.stopPropagation();
+              if (e.key === 'Escape' && !busy) setMeta(null);
+            }}
+            style={{
+              position: 'fixed',
+              inset: 0,
+              zIndex: 10000,
+              background: '#0005',
+              display: 'grid',
+              placeItems: 'center',
+            }}
+          >
+            <form
+              onSubmit={(e) => {
+                e.preventDefault();
+                void publish();
+              }}
+              style={{
+                width: 580,
+                maxWidth: '92vw',
+                maxHeight: '90vh',
+                overflow: 'auto',
+                background: 'var(--affine-background-primary-color, white)',
+                padding: 28,
+                borderRadius: 14,
+                boxShadow: '0 20px 80px #0003',
+                display: 'grid',
+                gap: 18,
+                fontSize: 14,
+              }}
+            >
+              <h2 style={{ margin: 0 }}>发布到博客</h2>
+              <p style={{ margin: 0, color: '#888' }}>
+                自动保存仅保存文档，不会发布。确认发布后更新本地博客，线上站点需重新部署。
+              </p>
+              <div
+                style={{
+                  display: 'grid',
+                  gridTemplateColumns: '1fr 1fr',
+                  gap: 16,
+                }}
+              >
+                <label>
+                  内容类型
+                  <select
+                    aria-label="内容类型"
+                    style={inputStyle}
+                    value={meta.kind}
+                    onChange={(e) => setMeta({ ...meta, kind: e.target.value })}
+                  >
+                    <option value="post">文章</option>
+                    <option value="page">页面</option>
+                  </select>
+                </label>
+                <label>
+                  语言
+                  <select
+                    aria-label="语言"
+                    style={inputStyle}
+                    value={meta.locale}
+                    onChange={(e) =>
+                      setMeta({ ...meta, locale: e.target.value })
+                    }
+                  >
+                    <option value="zh-CN">中文</option>
+                    <option value="en">English</option>
+                  </select>
+                </label>
+                {field('slug', '地址名称', 'my-article')}
+                {meta.kind === 'post' &&
+                  field('directory', '文章目录', 'notes')}
+                {meta.kind === 'post' &&
+                  field('date', '发布日期', '2026-10-17 12:00')}
+                {meta.kind === 'post' && field('category', '分类')}
+              </div>
+              <label>
+                摘要
+                <textarea
+                  aria-label="摘要"
+                  rows={3}
+                  style={{ ...inputStyle, resize: 'vertical' }}
+                  value={meta.description}
+                  onChange={(e) =>
+                    setMeta({ ...meta, description: e.target.value })
+                  }
+                />
+              </label>
+              {meta.kind === 'post' && (
+                <>
+                  <label>
+                    标签
+                    <input
+                      aria-label="标签"
+                      style={inputStyle}
+                      value={meta.tags.join(', ')}
+                      onChange={(e) =>
+                        setMeta({
+                          ...meta,
+                          tags: e.target.value
+                            .split(/[,，]/)
+                            .map((s) => s.trim()),
+                        })
+                      }
+                    />
+                  </label>
+                  {field('cover', '封面地址')}
+                  <label>
+                    <input
+                      type="checkbox"
+                      style={{
+                        appearance: 'auto',
+                        width: 16,
+                        height: 16,
+                        marginRight: 6,
+                      }}
+                      checked={meta.draft}
+                      onChange={(e) =>
+                        setMeta({ ...meta, draft: e.target.checked })
+                      }
+                    />{' '}
+                    保存为草稿
+                  </label>
+                </>
+              )}
+              {meta.kind === 'page' && (
+                <label>
+                  <input
+                    type="checkbox"
+                    style={{
+                      appearance: 'auto',
+                      width: 16,
+                      height: 16,
+                      marginRight: 6,
+                    }}
+                    checked={meta.comments}
+                    onChange={(e) =>
+                      setMeta({ ...meta, comments: e.target.checked })
+                    }
+                  />{' '}
+                  启用评论
+                </label>
+              )}
+              {error && (
+                <p role="alert" style={{ margin: 0, color: '#c62828' }}>
+                  {error}
+                </p>
+              )}
+              <div
+                style={{ display: 'flex', justifyContent: 'flex-end', gap: 12 }}
+              >
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => setMeta(null)}
+                  style={buttonStyle}
+                >
+                  取消
+                </button>
+                <button
+                  disabled={busy}
+                  style={{
+                    ...buttonStyle,
+                    background: '#1e6de5',
+                    color: 'white',
+                  }}
+                >
+                  {busy ? '正在发布…' : '确认发布'}
+                </button>
+              </div>
+            </form>
+          </div>,
+          document.body
+        )}
+    </>
+  );
+}
+const inputStyle = {
+  display: 'block',
+  width: '100%',
+  padding: '8px 10px',
+  borderRadius: 6,
+  border: '1px solid #aaa7',
+  background: 'transparent',
+  color: 'inherit',
+  marginTop: 4,
+};
+const buttonStyle = {
+  border: '1px solid #aaa5',
+  borderRadius: 7,
+  padding: '7px 12px',
+  cursor: 'pointer',
+  background: 'transparent',
+  color: 'inherit',
+  whiteSpace: 'nowrap' as const,
+};
