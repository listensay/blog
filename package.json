{
  "name": "blog",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "nuxt build && wrangler deploy",
    "affine:build": "node scripts/affine/build.mjs",
    "affine:clean": "node scripts/affine/clean.mjs",
    "affine:patch": "node scripts/affine/patch.mjs",
    "admin": "npm --prefix admin run dev",
    "check:site": "node scripts/check-site.mjs",
    "check:affine-build": "node --test scripts/affine/artifacts.test.mjs",
    "admin:build": "npm --prefix admin run build"
  },
  "dependencies": {
    "@nuxt/content": "3.15.2",
    "@tabler/icons-vue": "3.46.0",
    "better-sqlite3": "12.11.1",
    "lightgallery": "2.9.0",
    "nuxt": "4.5.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "oxc-parser": "0.158.0",
    "tailwindcss": "4.3.3",
    "wrangler": "4.120.1"
  }
}
