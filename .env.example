# 本地开发用的密钥。复制成 .env 后填上自己的值（.env 不会进 git）。
# 线上（Cloudflare）不要用这个文件，改用：
#   npx wrangler secret put NUXT_ADMIN_PASSWORD
#   npx wrangler secret put NUXT_SESSION_SECRET
#   npx wrangler secret put NUXT_VISITOR_SALT

# /admin 的登录密码。不设置的话后台整体关闭（不会变成空密码可进）
NUXT_ADMIN_PASSWORD=

# 给管理会话 cookie 签名用，随便一串长随机字符串
# 生成：openssl rand -hex 32
NUXT_SESSION_SECRET=

# 访客指纹的盐。换掉它等于重置所有「24 小时内算一次浏览」和点赞去重的判定
NUXT_VISITOR_SALT=
