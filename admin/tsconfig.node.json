// TSConfig for modules that run in Node.js environment via either transpilation or type-stripping.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*",
    // 本地文件接口，跑在 Vite 的 Node 进程里
    "server/**/*"
  ],
  // scripts/ 刻意不放进来：那些脚本要用 DOM（jsdom）跑富文本往返检查，
  // 把 DOM 的 lib 加进 Node 项目会让 server/ 里误用浏览器 API 也检查不出来。
  // 它们由 `npm run check` 直接用 node 跑，出问题会立刻炸。
  "compilerOptions": {
    // Most tools use transpilation instead of Node.js's native type-stripping.
    // Bundler mode provides a smoother developer experience.
    "module": "preserve",
    "moduleResolution": "bundler",

    // server/ 里的 import 都写全 `./x.ts` 后缀：Vite 8 的原生配置加载器会对
    // 省略后缀的 import 逐条告警（每次 npm run dev 刷一屏），写全就干净了
    "allowImportingTsExtensions": true,

    // Include Node.js types and avoid accidentally including other `@types/*` packages.
    "types": ["node"],

    // Disable emitting output during `vue-tsc --build`, which is used for type-checking only.
    "noEmit": true,

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
