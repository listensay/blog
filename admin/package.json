{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "blog 本地后台：AFFiNE 源码工作区、作品与站点设置",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check": "run-s type-check check:nav check:api check:affine check:journals",
    "check:journals": "node --experimental-strip-types scripts/check-journals.ts",
    "check:nav": "node --experimental-strip-types scripts/check-nav.ts",
    "check:api": "node --experimental-strip-types scripts/check-api.ts",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ server/ scripts/",
    "check:affine": "node --experimental-strip-types scripts/check-affine.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.75.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
