{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Immki Blog Tauri 桌面管理应用",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "type-check": "vue-tsc --build",
    "check": "run-s type-check check:nav check:auto-save check:api check:comments check:affine check:journals check:git-sync",
    "check:git-sync": "node --experimental-strip-types scripts/check-git-sync.ts",
    "check:comments": "node --experimental-strip-types scripts/check-comments.ts",
    "check:auto-save": "node --experimental-strip-types scripts/check-auto-save.ts",
    "check:journals": "node --experimental-strip-types scripts/check-journals.ts",
    "check:nav": "node --experimental-strip-types scripts/check-nav.ts",
    "check:api": "node --experimental-strip-types scripts/check-api.ts",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ server/ scripts/",
    "check:affine": "node --experimental-strip-types scripts/check-affine.ts",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "check:desktop": "npm run desktop:prepare && cargo check --manifest-path src-tauri/Cargo.toml && node scripts/check-desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.75.0",
    "prettier": "3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^24.12.0 || >=26.0.0"
  }
}
